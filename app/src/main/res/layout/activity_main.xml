<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Main Horizontal Split: BBLL-style Left Rail + Douyin Stage -->
    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left Navigation Rail -->
        <LinearLayout
            android:id="@+id/sidebarLayout"
            android:layout_width="132dp"
            android:layout_height="match_parent"
            android:background="@color/bg_sidebar"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/app_name"
                android:textColor="@color/brand_red"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRecommend"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_sidebar_item"
                android:focusable="true"
                android:text="@string/nav_recommend"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnDiscover"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_sidebar_item"
                android:focusable="true"
                android:text="@string/nav_discover"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnFollow"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_sidebar_item"
                android:focusable="true"
                android:text="@string/nav_follow"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnHot"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_sidebar_item"
                android:focusable="true"
                android:text="@string/nav_hot"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_sidebar_item"
                android:focusable="true"
                android:text="@string/nav_login"
                android:textColor="@color/brand_cyan"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_sidebar_item"
                android:focusable="true"
                android:text="@string/nav_settings"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Video / Web Stage -->
        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100"
                android:progressTint="@color/brand_red"
                android:visibility="gone" />

            <TextView
                android:id="@+id/toastBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="#B3000000"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="@string/hint_remote"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Fullscreen HTML5 Video Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- TV Settings Overlay -->
    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dim"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/bg_sidebar"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="DouyinTV 设置"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleSidebar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_menu_item"
                android:focusable="true"
                android:text="隐藏左侧导航栏 (沉浸模式)"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnAutoPlayNext"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_menu_item"
                android:focusable="true"
                android:text="播完自动切下一个: 开启"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnOrientation"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_menu_item"
                android:focusable="true"
                android:text="画面方向: 自动"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnCompatMode"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_menu_item"
                android:focusable="true"
                android:text="兼容模式 (手机版UA): 关闭"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_menu_item"
                android:focusable="true"
                android:text="刷新当前页面"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnClearCache"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_menu_item"
                android:focusable="true"
                android:text="清除缓存并退出登录"
                android:textColor="@color/brand_red" />

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_menu_item"
                android:focusable="true"
                android:text="关闭菜单"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvWebViewVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
